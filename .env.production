APP_TITLE=MyApiService
APP_VERSION=0.1.0
APP_MONGO_URI=mongodb://user:password@localhost/db
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_SECRET_KEY_MIDDLEWARE=my_secret_to_middleware
APP_SECRET_TOKENS=
APP_GOOGLE_CLOUD_STORAGE="<cloud-storage.json>"
APP_GOOGLE_CLOUD_STORAGE_PATH="./keys/cloud-storage.json"
APP_GOOGLE_CLOUD_STORAGE_BUCKET=bucket
TRAEFIK_ROUTE=service_name
TRAEFIK_APP_DOMAIN=`dom1.example.com`,`dom2.example.com`
TRAEFIK_APP_PORT=8000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10